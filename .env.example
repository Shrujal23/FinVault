# Copy this file to .env and replace every placeholder.
# Never commit .env or real secrets.

# --- MySQL ---
MYSQL_DATABASE=fintech_portfolio
MYSQL_USERNAME=finvault
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_base64_secret
JWT_EXPIRATION=1d

# --- App ---
CORS_ALLOWED_ORIGINS=http://localhost
AUTH_RETURN_RESET_TOKEN=false
VITE_API_BASE=/
LOGGING_LEVEL_ROOT=INFO

# --- Optional market-data keys ---
ALPHAVANTAGE_API_KEY=
COINGECKO_API_KEY=
ALPHAVANTAGE_BASE=https://www.alphavantage.co/query
COINGECKO_BASE=https://api.coingecko.com/api/v3
NSE_BASE=https://www.nseindia.com
BSE_BASE=https://api.bseindia.com
YAHOO_SEARCH_BASE=https://query2.finance.yahoo.com
YAHOO_QUOTE_BASE=https://query1.finance.yahoo.com
